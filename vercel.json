{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.celebud.com" }],
      "destination": "https://celebud.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://ucsuyrhlhmqezubfoszx.supabase.co/functions/v1/generate-sitemap"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Gg]ooglebot|[Bb]ingbot|[Yy]andex|[Dd]uck[Dd]uck[Bb]ot|[Bb]aiduspider|facebookexternalhit|[Ff]acebook[Cc]atalog|[Tt]witterbot|[Ll]inked[Ii]n[Bb]ot|[Ss]lack[Bb]ot|[Dd]iscordbot|[Ww]hats[Aa]pp|[Tt]elegram[Bb]ot|[Pp]interest|[Rr]edditbot|[Aa]pplebot|[Pp]etal[Bb]ot).*"
        }
      ],
      "destination": "https://ucsuyrhlhmqezubfoszx.supabase.co/functions/v1/prerender?path=/"
    },
    {
      "source": "/article/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Gg]ooglebot|[Bb]ingbot|[Yy]andex|[Dd]uck[Dd]uck[Bb]ot|[Bb]aiduspider|facebookexternalhit|[Ff]acebook[Cc]atalog|[Tt]witterbot|[Ll]inked[Ii]n[Bb]ot|[Ss]lack[Bb]ot|[Dd]iscordbot|[Ww]hats[Aa]pp|[Tt]elegram[Bb]ot|[Pp]interest|[Rr]edditbot|[Aa]pplebot|[Pp]etal[Bb]ot).*"
        }
      ],
      "destination": "https://ucsuyrhlhmqezubfoszx.supabase.co/functions/v1/prerender?path=/article/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/ads.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}

